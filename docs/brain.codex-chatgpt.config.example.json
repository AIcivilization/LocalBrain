{
  "defaultProvider": "codex-chatgpt-local",
  "defaultModel": "gpt-5.4-mini",
  "models": ["gpt-5.4-mini", "gpt-5.5", "claude-code/sonnet", "claude-code/opus"],
  "providers": {
    "codex-chatgpt-local": {
      "type": "codex-chatgpt-local",
      "displayName": "Codex ChatGPT Local Provider",
      "baseUrl": "https://chatgpt.com/backend-api/codex/responses",
      "localOnly": false,
      "experimental": true,
      "options": {
        "clientId": "app_EMoamEEZ73f0CkXaXp7hrann",
        "userAgent": "brain-local-codex-provider/0.1",
        "modelCacheTtlMs": 60000,
        "forceProxy": true
      }
    },
    "claude-code-local": {
      "type": "claude-code-local",
      "displayName": "Claude Code Local Provider",
      "localOnly": true,
      "experimental": true,
      "options": {
        "timeoutMs": 900000,
        "modelCacheTtlMs": 60000,
        "settingSources": "project,local",
        "forceProxy": true
      }
    },
    "opencode-local": {
      "type": "opencode-local",
      "displayName": "OpenCode Local Provider",
      "baseUrl": "http://127.0.0.1:4096",
      "localOnly": true,
      "experimental": true,
      "options": {
        "modelProvider": "opencode",
        "forceProxy": true
      }
    },
    "antigravity-local": {
      "type": "antigravity-local",
      "displayName": "Antigravity Local Provider",
      "localOnly": false,
      "experimental": true,
      "options": {
        "sqlitePath": "sqlite3",
        "modelCacheTtlMs": 60000,
        "forceProxy": true
      }
    },
    "grok-local": {
      "type": "agent-cli-local",
      "displayName": "Grok Bot Local Provider",
      "localOnly": false,
      "experimental": true,
      "options": {
        "vendor": "grok",
        "timeoutMs": 900000,
        "modelCacheTtlMs": 60000,
        "forceProxy": true
      }
    },
    "qoder-local": {
      "type": "agent-cli-local",
      "displayName": "Qoder Local Provider",
      "localOnly": false,
      "experimental": true,
      "options": {
        "vendor": "qoder",
        "timeoutMs": 900000,
        "modelCacheTtlMs": 60000,
        "forceProxy": false
      }
    },
    "workbuddy-local": {
      "type": "agent-cli-local",
      "displayName": "WorkBuddy Local Provider",
      "localOnly": false,
      "experimental": true,
      "options": {
        "vendor": "workbuddy",
        "timeoutMs": 900000,
        "modelCacheTtlMs": 60000,
        "forceProxy": false
      }
    },
    "workbuddy-ai-local": {
      "type": "agent-cli-local",
      "displayName": "WorkBuddy AI Local Provider",
      "localOnly": false,
      "experimental": true,
      "options": {
        "vendor": "workbuddy-ai",
        "timeoutMs": 900000,
        "modelCacheTtlMs": 60000,
        "forceProxy": false
      }
    }
  },
  "server": {
    "host": "127.0.0.1",
    "port": 8787,
    "requireAuth": true,
    "apiKeys": ["local-brain-dev-key"],
    "publicBaseUrl": "http://127.0.0.1:8787",
    "auditLogPath": "logs/brain-server-audit.jsonl"
  },
  "routing": {
    "chat": {
      "providerId": "codex-chatgpt-local",
      "model": "gpt-5.4-mini"
    },
    "fast": {
      "providerId": "codex-chatgpt-local",
      "model": "gpt-5.4-mini"
    },
    "code": {
      "providerId": "codex-chatgpt-local",
      "model": "gpt-5.5"
    },
    "tool-use": {
      "providerId": "codex-chatgpt-local",
      "model": "gpt-5.5"
    }
  },
  "tools": {
    "enabled": false,
    "allowlist": [],
    "maxToolCalls": 0
  },
  "memory": {
    "mode": "session",
    "maxSessionMessages": 20
  },
  "policy": {
    "allowNetworkModelCalls": true,
    "allowExperimentalSubscriptionLogin": true,
    "allowProductStateInPrompt": true,
    "requireToolAllowlist": true
  }
}
